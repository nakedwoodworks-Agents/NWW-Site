---
import Base from '../../layouts/Base.astro';
---
<Base seoTitle="Affiliate Login" description="Log in to your Naked Wood Works affiliate dashboard." path="/affiliates/login/" noindex showQuizFloat={false}>
  <section class="wrap section">
    <div class="aff-form">
      <p class="eyebrow center">Affiliate program</p>
      <h1 class="center">Affiliate login</h1>
      <div id="msg" role="status" aria-live="polite"></div>
      <form id="f" novalidate>
        <div class="fld"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        <div class="fld"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
        <button class="btn btn-gold btn-block" type="submit">Log in</button>
      </form>
      <p class="center muted" style="margin-top:18px">Forgot your password? Email us and we will reset it.</p>
      <p class="center">Not an affiliate yet? <a href="/affiliates/apply/">Apply here</a></p>
    </div>
  </section>
  <script is:inline>
    (function(){
      var f = document.getElementById('f'), msg = document.getElementById('msg');
      f.addEventListener('submit', function(e){
        e.preventDefault();
        var b = f.querySelector('button'); b.disabled = true;
        fetch('/api/aff/login', { method:'POST', headers:{'content-type':'application/json'}, credentials:'same-origin', body: JSON.stringify(Object.fromEntries(new FormData(f))) })
          .then(function(r){ return r.json().catch(function(){ return { ok:false, error:'Could not reach the server.' }; }); })
          .then(function(j){
            if (j.ok) { location.href = '/affiliates/dashboard/'; return; }
            msg.className = 'msg bad'; msg.textContent = j.error || 'Something went wrong.'; b.disabled = false;
          });
      });
    })();
  </script>
</Base>
